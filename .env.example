ENABLE_EXPERIMENTAL_COREPACK=1
NODE_ENV=development
# Niveles disponibles (separados por coma): log,error,warn,debug,verbose
# Usar "verbose" para ver el body de las peticiones HTTP
LOGGER_LEVEL=log
PORT=3000
CORS_ALLOWED=http://localhost:3001

############
# DATABASE #
############
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=luckybet

#######
# JWT #
#######
JWT_SECRET=your-secret-key-change-in-production
EXPIRES_IN_TOKEN=86400


##########
# SEEDER #
##########
ADMIN_USER=al
PASSWORD=1212316

##########
# STORAGE #
##########
# Cloudflare R2 (S3-compatible) para subir imagenes de misiones y pasos.
# Si STORAGE_ENDPOINT esta vacio, se construye desde CL_ACC_ID.
STORAGE_ENDPOINT=
# Region del bucket (R2 usa "auto")
STORAGE_REGION=auto
# Credenciales S3. Si estan vacias, se usan CL_ACCESS_KEY_ID / CL_ACCESS_KEY_SC.
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
# Nombre del bucket donde se guardan las imagenes
STORAGE_BUCKET=luckybet-premios
# URL publica base para generar las URLs de las imagenes.
# Si esta vacia, se usa <endpoint>/<bucket>.
STORAGE_PUBLIC_URL=
